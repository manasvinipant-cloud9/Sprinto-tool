{
  "name": "outreach-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db-check": "node --env-file=.env.local --import tsx scripts/db-check.ts",
    "profiles-check": "node --env-file=.env.local --import tsx scripts/profiles-check.ts",
    "phase2-check": "node --env-file=.env.local --import tsx scripts/phase2-check.ts",
    "phase4-check": "node --env-file=.env.local --import tsx scripts/phase4-check.ts",
    "phase5-check": "node --env-file=.env.local --import tsx scripts/phase5-check.ts",
    "add-user": "node --env-file=.env.local --import tsx scripts/add-user.ts",
    "phase6-check": "node --env-file=.env.local --import tsx scripts/phase6-check.ts",
    "bundle-check": "node --env-file=.env.local --import tsx scripts/bundle-check.ts",
    "phase6-http-check": "node --env-file=.env.local --import tsx scripts/phase6-http-check.ts",
    "worker": "node --env-file=.env.local --import tsx scripts/worker.ts",
    "preflight": "node --env-file=.env.local --import tsx scripts/preflight.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "cheerio": "^1.2.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
