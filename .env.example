# Hunter.io API key (free plan: 25 searches a month)
HUNTER_API_KEY=
# gemini (default) or anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Model names. Leave empty to use the defaults in lib/llm.ts. Run `npm run preflight` to verify them.
LLM_MODEL_CHEAP=
LLM_MODEL_STRONG=
# Minimum gap between LLM calls in ms (free tier rate limits). Default 4000.
LLM_MIN_INTERVAL_MS=

# Supabase (server only, never expose to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# The public (publishable) key. Safe to expose in principle, but kept server-side here: the browser never talks to Supabase directly.
SUPABASE_PUBLISHABLE_KEY=
# 32 random bytes, base64. Encrypts per-workspace API keys. Generate with: openssl rand -base64 32
# Losing it makes stored workspace keys unreadable; changing it requires re-entering them.
SECRETS_KEY=
# Optional read-only demo: visitors are signed in automatically as this user, who can only look. Create it with: npm run setup-demo
DEMO_EMAIL=
DEMO_PASSWORD=
DEMO_USER_ID=
