# Who receives every test email (your own address). The app never sends anywhere else.
SEND_TO=
# Name that signs emails when a profile does not set its own
SENDER_NAME=
# Shared password that protects the deployed app and its API
APP_PASSWORD=
# Hunter.io API key (free plan: 25 searches a month)
HUNTER_API_KEY=
# gemini (default) or anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Model names. Leave empty to use the defaults in lib/llm.ts. Run `npm run preflight` to verify them.
LLM_MODEL_CHEAP=
LLM_MODEL_STRONG=
# Minimum gap between LLM calls in ms (free tier rate limits). Default 4000.
LLM_MIN_INTERVAL_MS=
# Gmail API (OAuth, gmail.send scope only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
